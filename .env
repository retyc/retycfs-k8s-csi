# Test cluster: read by the Vagrantfile and by the Makefile's vm-* targets. Override any line in
# .env.local (not versioned), or for one make run with `make vm-helm CLUSTER_CHART=dev`.
# KEY=value lines, no quotes, no `export`.

# prod by default: only the Retyc team reaches the development API, and sets dev in .env.local.
# dev:  this repo's chart, the driver image built here (make image-dev vm-load) and the dev CLI,
#       against the development API (examples/helm-values/dev-vagrant-values.yaml).
# prod: the published chart (https://retyc.github.io/retycfs-k8s-csi) and its released images,
#       against the production API (examples/helm-values/prod-vagrant-values.yaml).
CLUSTER_CHART=prod

# multi:  two nodes (server + agent) and the shared Redis cache (examples/helm-values/redis-values.yaml).
# single: the server alone, memory cache.
CLUSTER_MODE=multi

# Credentials of the Retyc account the driver uses (make vm-secret): a dev account with
# CLUSTER_CHART=dev, a production one with prod. In .env.local only, never in this file.
# RETYC_TOKEN=
# RETYC_KEY_PASSPHRASE=
