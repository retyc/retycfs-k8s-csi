{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "retycfs-csi values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "credentials": { "description": "Removed (token identity): the chart fails with an explanation, see identity.organizationID" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizationID": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$"
        },
        "clusterName": { "type": "string", "minLength": 1, "maxLength": 63 }
      }
    },
    "storageClasses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
          "reclaimPolicy": { "type": "string", "enum": ["Delete", "Retain"] },
          "volumeBindingMode": { "type": "string", "enum": ["Immediate", "WaitForFirstConsumer"] },
          "isDefault": { "type": "boolean" },
          "annotations": { "type": "object" },
          "tenant": { "type": "boolean" }
        },
        "required": ["name"]
      }
    },
    "rbac": { "type": "object", "properties": { "create": { "type": "boolean" } } },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "controller": { "$ref": "#/$defs/serviceAccount" },
        "node": { "$ref": "#/$defs/serviceAccount" },
        "enroller": { "$ref": "#/$defs/serviceAccount" }
      }
    },
    "extraObjects": { "type": "array", "items": { "type": "object" } },
    "healthPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "metrics": {
      "type": "object",
      "properties": {
        "podMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "labels": { "type": "object" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "relabelings": { "type": "array", "items": { "type": "object" } },
            "metricRelabelings": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    },
    "logLevel": { "type": "integer", "minimum": 0, "maximum": 10 },
    "probes": {
      "type": "object",
      "properties": {
        "liveness": { "$ref": "#/$defs/probe" },
        "readiness": { "$ref": "#/$defs/probe" }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "hostAliases": { "type": "array", "items": { "type": "object" } },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "extraEnv": { "type": "array", "items": { "type": "object" } },
        "extraVolumes": { "type": "array", "items": { "type": "object" } },
        "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
        "resources": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
        "priorityClassName": { "type": "string" },
        "provisioner": {
          "type": "object",
          "properties": {
            "image": { "$ref": "#/$defs/sidecarImage" },
            "extraArgs": { "type": "array", "items": { "type": "string" } },
            "resources": { "type": "object" }
          }
        },
        "resizer": {
          "type": "object",
          "properties": {
            "image": { "$ref": "#/$defs/sidecarImage" },
            "extraArgs": { "type": "array", "items": { "type": "string" } },
            "resources": { "type": "object" }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "properties": {
        "kubeletDir": { "type": "string", "pattern": "^/" },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "extraEnv": { "type": "array", "items": { "type": "object" } },
        "extraVolumes": { "type": "array", "items": { "type": "object" } },
        "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
        "resources": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "priorityClassName": { "type": "string" },
        "updateStrategy": { "type": "object" },
        "registrar": {
          "type": "object",
          "properties": {
            "image": { "$ref": "#/$defs/sidecarImage" },
            "resources": { "type": "object" }
          }
        }
      }
    },
    "enroller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostAliases": { "type": "array", "items": { "type": "object" } },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "extraEnv": { "type": "array", "items": { "type": "object" } },
        "extraVolumes": { "type": "array", "items": { "type": "object" } },
        "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
        "resources": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "priorityClassName": { "type": "string" }
      }
    },
    "mount": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/$defs/sidecarImage" },
        "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
        "extraEnv": { "type": "array", "items": { "type": "object" } },
        "hostAliases": { "type": "array", "items": { "type": "object" } },
        "hostPID": { "type": "boolean" },
        "resources": { "type": "object" },
        "drainTimeout": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" },
        "priorityClassName": { "type": "string" },
        "spoolDir": { "type": "string", "pattern": "^/" }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store": { "type": "string", "enum": ["memory", "redis"] },
        "highConfidentiality": { "type": "boolean" },
        "redis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subchart": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "password": { "type": "string", "pattern": "^[A-Za-z0-9._~-]*$" },
                "existingSecret": { "type": "string" }
              }
            },
            "external": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": { "type": "string", "pattern": "^(rediss?://.+)?$" },
                "existingSecret": { "type": "string" },
                "existingSecretKey": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "admissionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "failurePolicy": { "type": "string", "enum": ["Fail", "Ignore"] }
      }
    },
    "redis": { "type": "object", "description": "Values of the CloudPirates Redis subchart, checked by its own schema." }
  },
  "$defs": {
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "sidecarImage": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository", "tag"]
    }
  }
}
